<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_discreet_background" />
    <foreground android:drawable="@drawable/ic_launcher_discreet_foreground" />
    <!--
        The disguise has to survive themed icons too: without this, an Android 13+ launcher in
        themed mode falls back to the full-color icon and the calculator cover stays intact but
        visually inconsistent with every other themed icon on the home screen.
    -->
    <monochrome android:drawable="@drawable/ic_launcher_discreet_foreground" />
</adaptive-icon>
