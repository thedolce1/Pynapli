<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ replacement for android:allowBackup (which stays false for API 23-30).

    Nothing this app stores locally may leave the device: the SQLDelight database holds the
    server-issued opaque access/refresh tokens, and app-private preferences hold the install id
    and the push-device registration. Restoring any of that onto a second device would hand it a
    live session, so both cloud backup and device-to-device transfer exclude every domain. The
    server is the authority for all of it — a reinstall re-authenticates and re-registers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
