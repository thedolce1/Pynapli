<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".PynapliApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Pynapli"
        android:supportsRtl="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:theme="@style/PynapliTheme">
        <!--
            No android:usesCleartextTraffic here. Release and staging both talk to https/wss hosts,
            so permitting plaintext would only widen the app to downgrade/MITM. The emulator's
            http://10.0.2.2:8080 loopback is the sole cleartext need, so the flag lives in
            src/debug/AndroidManifest.xml and is merged into debug builds only.
        -->
        <!--
            MainActivity no longer carries the LAUNCHER filter directly. The home-screen entry is one
            of two activity-aliases so the user can disguise the app: the default Pynapli icon, or a
            discreet (calculator) icon. Exactly one alias is enabled at a time via AppIconService
            (PackageManager.setComponentEnabledSetting). The default alias is enabled at install; the
            discreet alias is disabled. Both launch MainActivity.

            Not exported, because those aliases are the only entry points another app should be able
            to start — an alias can be exported while its targetActivity is not. Note this also means
            `adb shell am start -n com.pynapli.app/.MainActivity` is refused (the shell user cannot
            start a non-exported component), so scripts/android-*-qa.ps1 launch
            .DefaultLauncherAlias instead. Own-process PendingIntents (notification deep links) are
            unaffected.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity-alias
            android:name=".DefaultLauncherAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="Pynapli">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".DiscreetLauncherAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_discreet"
            android:roundIcon="@mipmap/ic_launcher_discreet_round"
            android:label="Calculator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".notifications.PynapliFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
