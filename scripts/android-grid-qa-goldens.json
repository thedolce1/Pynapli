{
  "version": 1,
  "description": "Connected Android Grid QA golden assertions. These are intentionally structural signatures rather than exact pixel images because emulator time, density, and platform chrome can vary.",
  "stages": {
    "gridInitial": {
      "requiredTexts": [
        "Current location",
        "Filters",
        "Online",
        "\u2264 50 km",
        "Singles",
        "Grid",
        "Swipe",
        "Activity",
        "Messages"
      ],
      "forbiddenTexts": [
        "Illegal input",
        "NETWORK_ERROR",
        "Request failed",
        "No one matches these filters right now."
      ],
      "minGridCards": 9,
      "image": {
        "minWidth": 720,
        "minHeight": 1280,
        "minDarkRatio": 0.45,
        "maxBrightRatio": 0.18,
        "minNonBlackRatio": 0.32,
        "minAccentYellowRatio": 0.0008,
        "minColorBucketCount": 12
      }
    },
    "filtersSheet": {
      "requiredTexts": [
        "Distance",
        "Within 50 km",
        "Age",
        "Presence",
        "Who",
        "Gender",
        "Orientation",
        "Online now",
        "Playing tonight",
        "Singles",
        "Linked",
        "Partnered"
      ],
      "_note": "Trust and its chips (Photo verified / Age verified) are deliberately NOT here: they render past the fold at sheet open now that Who/Gender/Orientation exist, so this stage can only assert what is actually on screen. The script asserts them after Scroll-SheetToText 'Trust' instead — coverage moved, not dropped.",
      "forbiddenTexts": [
        "Illegal input",
        "NETWORK_ERROR",
        "Request failed"
      ],
      "image": {
        "minWidth": 720,
