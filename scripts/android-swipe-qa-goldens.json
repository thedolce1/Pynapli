{
  "version": 1,
  "description": "Connected Android Swipe QA golden assertions. These use structural text and screenshot signatures instead of exact pixels because emulator time, density, and seeded thumbnails can vary.",
  "stages": {
    "swipeInitial": {
      "requiredTexts": [
        "Swipe",
        "Travel",
        "Filters",
        "For You",
        "Linked",
        "Age",
        "Rewind",
        "Pass",
        "Pineapple Like",
        "Like",
        "Grid",
        "Activity",
        "Messages"
      ],
      "forbiddenTexts": [
        "Illegal input",
        "NETWORK_ERROR",
        "Request failed",
        "No more profiles nearby",
        "No more recommendations match your filters",
        "1 pending"
      ],
      "image": {
        "minWidth": 720,
        "minHeight": 1280,
        "minDarkRatio": 0.35,
        "maxBrightRatio": 0.24,
        "minNonBlackRatio": 0.25,
        "minAccentYellowRatio": 0.0005,
        "minColorBucketCount": 12
      }
    },
    "filtersSheet": {
      "requiredTexts": [
        "These shape who shows up in your deck.",
        "Who",
        "Gender",
        "Orientation",
        "Age",
        "Distance"
      ],
      "_note": "Intent and Style are deliberately NOT here: the Gender/Orientation sections push them past the fold at sheet open, so this stage can only assert what is actually on screen. The script asserts them after Scroll-SheetToText instead — coverage moved, not dropped.",
      "forbiddenTexts": [
        "Illegal input",
        "NETWORK_ERROR",
        "Request failed"
      ],
      "image": {
        "minWidth": 720,
        "minHeight": 1280,
        "minDarkRatio": 0.45,
        "maxBrightRatio": 0.20,
        "minNonBlackRatio": 0.04,
        "minAccentYellowRatio": 0.001,
        "minColorBucketCount": 8
      }
    },
    "travelSheet": {
      "requiredTexts": [
