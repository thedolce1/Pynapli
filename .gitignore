# Gradle
.gradle/
build/
**/build/

# Kotlin / IDE
.idea/
*.iml
out/
.kotlin/

# Claude Code (local per-machine overrides only)
.claude/settings.local.json
.claude/worktrees/
.claude/*.lock

# Generated local QA artifacts
artifacts/
logs/

# Android
local.properties
captures/
*.apk
*.aab

# iOS / Xcode
iosApp/DerivedData/
iosApp/*.xcworkspace/xcuserdata/
iosApp/*.xcodeproj/xcuserdata/
iosApp/*.xcodeproj/project.xcworkspace/xcuserdata/

# Secrets / env
.env
.env.*
!.env.example
google-services.json
GoogleService-Info.plist
service-account*.json
# Release signing material. The upload/release keystore is referenced by path via
# pynapli.android.releaseKeystore (see androidApp/build.gradle.kts) and must never be committed —
# leaking it lets anyone publish an update to the Play listing.
*.jks
*.keystore

# Local media upload sink
.pynapli-local-media/
.pynapli-account-exports/

# Local server logs
.pynapli-local-logs/
.pynapli-logs/

# OS
.DS_Store
Thumbs.db
