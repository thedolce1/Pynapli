# Normalize line endings: store text as LF in the repo, check out LF on every platform.
# Keeps Spotless/ktlint output and git diffs deterministic (no CRLF churn on Windows).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf

# Binary assets must not be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.jar binary
*.apk binary
*.keystore binary
*.jks binary
