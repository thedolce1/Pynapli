# Pynapli web — environment variables
# Copy to .env.local and fill in for your environment.

# URL of the Ktor :server backend. Server-side only — never exposed to the
# browser. The BFF in /api/* talks to this URL.
PYNAPLI_API_BASE_URL=http://localhost:8080

# Cookie domain for session cookies. Leave empty in dev (cookies scoped to
# the request host). In production, set to .pynapli.com so cookies are
# valid across pynapli.com and web.pynapli.com.
PYNAPLI_COOKIE_DOMAIN=

# Public URLs surfaced in metadata, OG tags, and Nav/Footer links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://web.localhost:3000
