---
// Safety is core product, not an upsell (PYNAPLI_PRODUCT_SPEC rule 9).
const items = [
  {
    t: 'Verification',
    d: 'Verified profiles so you know who’s real before you connect.',
    icon: '<path d="M12 3 4 6.5v5c0 4.6 3.2 7.8 8 9.5 4.8-1.7 8-4.9 8-9.5v-5L12 3Z"/><path d="m8.5 11.8 2.4 2.4 4.6-4.8"/>',
  },
  {
    t: 'Private albums',
    d: 'Your private photos are yours — shared only when you decide, never automatically.',
    icon: '<rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
  },
  {
    t: 'Block &amp; hide',
    d: 'Full control over who can reach you, see you, or reappear.',
    icon: '<circle cx="12" cy="12" r="8.5"/><path d="m6 6 12 12"/>',
  },
  {
    t: 'Discreet icon',
    d: 'A discreet app icon that blends quietly into your home screen.',
    icon: '<path d="M12 4c-4 4-7 6.5-7 10a7 7 0 0 0 14 0c0-3.5-3-6-7-10Z"/>',
  },
  {
    t: 'Your location',
    d: 'Discovery uses your approximate area — your exact spot is never shown.',
    icon: '<path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z"/><circle cx="12" cy="10" r="2.4"/>',
  },
  {
    t: '18+ &amp; moderated',
    d: 'Strictly adults, age-gated, with active moderation and reporting.',
    icon: '<circle cx="12" cy="12" r="8.5"/><path d="M12 8v5" /><circle cx="12" cy="16" r="0.5" fill="currentColor"/>',
  },
];
---

<section class="safety" id="safety">
  <div class="container">
    <header class="lead reveal">
      <p class="eyebrow">Safety &amp; privacy</p>
      <h2>Built to be <em>controlled.</em></h2>
      <p class="sub">
        Safety here isn’t a premium add-on — it’s the product. You decide what’s seen, who reaches
        you, and how much you share.
      </p>
    </header>
    <div class="sgrid">
      {
        items.map((i) => (
          <div class="scard reveal">
            <span class="sicon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={i.icon} />
            </span>
            <h3 set:html={i.t} />
            <p set:html={i.d} />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .safety {
    padding: clamp(64px, 10vw, 128px) 0;
    position: relative;
    z-index: 2;
  }
  .lead {
    max-width: 34ch;
    margin-bottom: clamp(38px, 5vw, 66px);
  }
  .lead h2 {
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    margin-top: 14px;
  }
  .lead em {
    font-style: italic;
    color: var(--gold);
  }
  .lead .sub {
    color: var(--text-2);
    margin-top: 18px;
    line-height: 1.6;
  }
  .sgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border-soft);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .scard {
    background: var(--bg);
    padding: clamp(24px, 3vw, 34px);
    transition: background 0.25s ease;
  }
  .scard:hover {
    background: var(--surface);
  }
  .sicon {
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    background: var(--gold-soft);
    color: var(--gold);
    margin-bottom: 18px;
  }
  .scard h3 {
    font-size: 1.15rem;
    margin-bottom: 9px;
  }
  .scard p {
    color: var(--text-2);
    font-size: 14.5px;
    line-height: 1.55;
  }
  @media (max-width: 820px) {
    .sgrid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .sgrid {
      grid-template-columns: 1fr;
    }
  }
</style>
