---
// Signature feature spotlight (PSYNC_SPEC): synchronized partner swiping — the same
// deck on two phones, private swipes, a together-match only on mutual interest plus
// the other person's consent. The feature no couple-account app can copy, because it
// depends on partners having their OWN accounts. Mirrored layout vs the Playing
// Tonight spotlight (visual left, copy right) for page rhythm.
---

<section class="psync" id="psync">
  <div class="container pgrid reveal">
    <div class="pvis">
      <div
        class="pstage"
        role="img"
        aria-label="Two phones showing the same profile card. Each partner swipes on their own phone, and a together match appears when both like the same person."
      >
        <span class="pglow" aria-hidden="true"></span>
        <div class="pphone left" aria-hidden="true">
          <span class="powner">You</span>
          <div class="pcard c1">
            <span class="pmeta"><i class="podot"></i>Sam · 1.2 mi</span>
          </div>
          <span class="pliked">Liked</span>
        </div>
        <div class="pphone right" aria-hidden="true">
          <span class="powner">Your partner</span>
          <div class="pcard c2">
            <span class="pmeta"><i class="podot"></i>Sam · 1.2 mi</span>
          </div>
          <span class="pliked">Liked</span>
        </div>
        <span class="ptogether" aria-hidden="true">✦ Together match</span>
        <span class="pnote">Same deck · your own phones</span>
      </div>
    </div>

    <div class="pcopy">
      <p class="eyebrow">Psync · only on Pynapli</p>
      <h2>Swipe together. <em>Stay yourselves.</em></h2>
      <p>
        Link your partner and <strong>Psync</strong> deals you both the same deck — on your own
        phones. You each swipe in private, and a together-match only happens when you both like
        someone and they’re interested too. Shared discovery, never a shared profile.
      </p>
      <ul class="pfeat">
        <li>One deck, two phones</li>
        <li>Swipes stay private</li>
        <li>A match takes all three yeses</li>
        <li>Never a couple account</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .psync {
    padding: clamp(64px, 10vw, 132px) 0;
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--border-soft);
  }
  .pgrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 80px);
    align-items: center;
  }
  .pcopy h2 {
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    margin-top: 16px;
  }
  .pcopy em {
    font-style: italic;
    color: var(--gold);
  }
  .pcopy p {
    color: var(--text-2);
    max-width: 46ch;
    line-height: 1.6;
    margin-top: 20px;
  }
  .pcopy p strong {
    color: var(--text);
    font-weight: 600;
  }
  .pfeat {
    list-style: none;
    padding: 0;
    margin: 26px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pfeat li {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-2);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 6px 12px;
  }

  /* ---- Two-phone stage ---- */
  .pvis {
    display: grid;
    place-items: center;
  }
  .pstage {
    position: relative;
    width: min(460px, 100%);
    aspect-ratio: 5 / 4;
    border-radius: 20px;
    overflow: hidden;
    background: radial-gradient(125% 125% at 50% 38%, #1c1626 0%, #0e0d14 58%, #0a0a0d 100%);
    border: 1px solid var(--border);
    box-shadow: 0 30px 70px -34px rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6%;
  }
  .pglow {
    position: absolute;
    left: 50%;
    top: 56%;
    width: 66%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 201, 40, 0.13), transparent 62%);
    pointer-events: none;
  }
  .pphone {
    position: relative;
    width: 31%;
    aspect-ratio: 9 / 16.5;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.85);
    padding: 7%;
    display: flex;
    flex-direction: column;
  }
  .pphone.left {
    transform: rotate(-4deg) translateY(4%);
  }
  .pphone.right {
    transform: rotate(4deg) translateY(4%);
  }
  .powner {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 7px;
  }
  .pcard {
    flex: 1;
    border-radius: 10px;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }
  /* The SAME person on both phones — identical gradient sells "one deck". */
  .pcard.c1,
  .pcard.c2 {
    background: linear-gradient(155deg, #4d3a2a 0%, #8a5a48 100%);
  }
  .pcard::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 46%;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.72));
  }
  .pmeta {
    position: absolute;
    left: 8px;
    bottom: 7px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 9.5px;
    font-weight: 600;
    color: var(--text);
  }
  .podot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--online);
    box-shadow: 0 0 5px rgba(24, 215, 122, 0.8);
  }
  .pliked {
    align-self: center;
    margin-top: 9px;
    font-size: 10px;
    font-weight: 700;
    color: var(--online);
    border: 1px solid rgba(24, 215, 122, 0.35);
    background: rgba(24, 215, 122, 0.1);
    border-radius: 100px;
    padding: 3px 10px;
  }
  .ptogether {
    position: absolute;
    left: 50%;
    top: 13%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 12px;
    font-weight: 700;
    color: #1a1400;
    background: var(--gold);
    border-radius: 100px;
    padding: 7px 14px;
    box-shadow: 0 10px 28px -10px rgba(255, 201, 40, 0.65);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ptogether {
      animation: pmatch 3.2s ease-in-out infinite;
    }
    @keyframes pmatch {
      0%,
      100% {
        transform: translateX(-50%) scale(1);
      }
      50% {
        transform: translateX(-50%) scale(1.05);
      }
    }
  }
  .pnote {
    position: absolute;
    right: 14px;
    bottom: 14px;
    font-size: 10.5px;
    letter-spacing: 0.02em;
    color: var(--text-3);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 5px 10px;
    background: rgba(0, 0, 0, 0.32);
  }

  @media (max-width: 820px) {
    .pgrid {
      grid-template-columns: 1fr;
    }
    .pcopy p {
      max-width: none;
    }
  }
</style>
