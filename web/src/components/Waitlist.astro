---
import StoreBadges from './StoreBadges.astro';

// Pre-launch waitlist (app isn't in stores yet). The form action is a placeholder the
// founder swaps for their email service (Mailchimp / ConvertKit / a Cloud Function).
---

<section class="waitlist" id="waitlist">
  <div class="container reveal">
    <div class="wl-card">
      <div class="wl-glow" aria-hidden="true"></div>
      <p class="eyebrow">Early access</p>
      <h2>Be first in your city.</h2>
      <p class="wl-sub">
        Pynapli is rolling out soon. Join the list and we’ll let you know the moment it’s live near
        you.
      </p>
      <form id="wl-form" class="wl-form" method="post" action="#">
        <input
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@email.com"
          aria-label="Email address"
        />
        <button class="btn btn-gold" type="submit">Get early access</button>
      </form>
      <p class="wl-note" id="wl-note">18+ only. No spam — just a heads-up at launch.</p>
      <div class="badges">
        <StoreBadges />
      </div>
    </div>
  </div>
</section>

<script>
  const f = document.getElementById('wl-form');
  f?.addEventListener('submit', (e) => {
    e.preventDefault();
    const note = document.getElementById('wl-note');
    f.innerHTML = '<p class="wl-thanks">You’re on the list. See you soon. 🍍</p>';
    if (note) note.remove();
  });
</script>

<style>
  .waitlist {
    padding: clamp(20px, 4vw, 40px) 0 clamp(72px, 10vw, 128px);
    position: relative;
    z-index: 2;
  }
  .wl-card {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(36px, 6vw, 72px) clamp(24px, 5vw, 64px);
    text-align: center;
  }
  .wl-glow {
    position: absolute;
    top: -40%;
    left: 50%;
    transform: translateX(-50%);
    width: 620px;
    height: 620px;
    max-width: 120%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 201, 40, 0.12), transparent 60%);
    pointer-events: none;
  }
  .wl-card > * {
    position: relative;
  }
  .wl-card h2 {
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    margin-top: 14px;
  }
  .wl-sub {
    color: var(--text-2);
    max-width: 46ch;
    margin: 18px auto 0;
    line-height: 1.6;
  }
  .wl-form {
    display: flex;
    gap: 10px;
    max-width: 460px;
    margin: 30px auto 0;
  }
  .wl-form input {
    flex: 1;
    min-width: 0;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 100px;
    color: var(--text);
    font: inherit;
    font-size: 15px;
    padding: 13px 20px;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .wl-form input::placeholder {
    color: var(--text-3);
  }
  .wl-form input:focus {
    border-color: var(--gold);
  }
  .wl-form .btn {
    flex-shrink: 0;
  }
  .wl-thanks {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--gold);
    margin: 30px 0 0;
  }
  .wl-note {
    color: var(--text-3);
    font-size: 13px;
    margin-top: 14px;
  }
  .badges {
    display: inline-flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 26px;
  }
  @media (max-width: 520px) {
    .wl-form {
      flex-direction: column;
    }
    .wl-form input,
    .wl-form .btn {
      width: 100%;
    }
    .wl-form .btn {
      justify-content: center;
    }
  }
</style>
