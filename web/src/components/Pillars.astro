---
// The three product pillars = the tagline, expanded. Alternating editorial rows.
---

<section class="pillars" id="how">
  <div class="container">
    <header class="lead reveal">
      <p class="eyebrow">The idea</p>
      <h2>Two proven ways to meet — <em>plus one nobody else does.</em></h2>
    </header>

    <!-- Grid -->
    <div class="prow reveal">
      <div class="ptext">
        <span class="pnum">01</span>
        <h3>Grid for now.</h3>
        <p>
          The fast lane. A live, dense grid of who’s open near you right now. Message without
          matching, and let strong filters do the work so every card counts.
        </p>
        <ul class="pfeat">
          <li>Live &amp; nearby</li>
          <li>Message first</li>
          <li>Filters that actually filter</li>
        </ul>
      </div>
      <div class="pvis">
        <div class="mini-grid">
          <span style="background:linear-gradient(150deg,#3a2a4d,#7a4a63)"><i class="on"></i></span>
          <span style="background:linear-gradient(150deg,#22303f,#3f6d78)"></span>
          <span style="background:linear-gradient(150deg,#4d3a2a,#8a6a3f)"><i class="on"></i></span>
          <span style="background:linear-gradient(150deg,#2a2a3f,#4a4a78)"></span>
          <span style="background:linear-gradient(150deg,#3f2a2a,#785a4a)"><i class="on"></i></span>
          <span style="background:linear-gradient(150deg,#2a3f38,#4a7863)"></span>
        </div>
      </div>
    </div>

    <!-- Swipe -->
    <div class="prow reveal">
      <div class="ptext">
        <span class="pnum">02</span>
        <h3>Swipe for intent.</h3>
        <p>
          Slow it down. Swipe when you mean it — mutual matches, likes, rewind, boosts, and chat
          that opens once it’s mutual. Discovery with intention, not noise.
        </p>
        <ul class="pfeat">
          <li>Mutual matches</li>
          <li>Rewind &amp; boosts</li>
          <li>Match-gated chat</li>
        </ul>
      </div>
      <div class="pvis">
        <div class="swipe-card" style="background:linear-gradient(155deg,#3a2a4d,#a06a5a)">
          <span class="sc-grain"></span>
          <span class="sc-scrim"></span>
          <span class="sc-meta"><b>Ava, 29</b><small>0.8 mi · online</small></span>
        </div>
        <div class="swipe-actions">
          <span class="sa pass">✕</span>
          <span class="sa like">♥</span>
        </div>
      </div>
    </div>

    <!-- Links -->
    <div class="prow reveal">
      <div class="ptext">
        <span class="pnum">03</span>
        <h3>Links for trust.</h3>
        <p>
          Bring your person. Link a partner as a visible, honest connection — never a merged
          account. Every adult keeps their own profile, chats, and control. This is the part no
          clone gets right.
        </p>
        <ul class="pfeat">
          <li>Autonomous accounts</li>
          <li>Visible partner link</li>
          <li>Solo, together, or social</li>
        </ul>
      </div>
      <div class="pvis">
        <div class="link-pair">
          <div class="lp-card" style="background:linear-gradient(150deg,#22303f,#3f6d78)"></div>
          <div class="lp-edge"><span>Linked</span></div>
          <div class="lp-card" style="background:linear-gradient(150deg,#4d3a2a,#8a6a3f)"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pillars {
    padding: clamp(64px, 10vw, 132px) 0;
    position: relative;
    z-index: 2;
  }
  .lead {
    max-width: 22ch;
    margin-bottom: clamp(40px, 6vw, 80px);
  }
  .lead h2 {
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    margin-top: 16px;
  }
  .lead em {
    font-style: italic;
    color: var(--gold);
  }

  .prow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 80px);
    align-items: center;
    padding: clamp(28px, 4vw, 44px) 0;
    border-top: 1px solid var(--border-soft);
  }
  .prow:nth-child(even) .pvis {
    order: -1;
  }
  .pnum {
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--gold);
    letter-spacing: 0.1em;
  }
  .ptext h3 {
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    margin: 12px 0 16px;
  }
  .ptext p {
    color: var(--text-2);
    max-width: 42ch;
    line-height: 1.6;
  }
  .pfeat {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pfeat li {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-2);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 6px 12px;
  }

  .pvis {
    display: grid;
    place-items: center;
  }

  /* Grid visual */
  .mini-grid {
    width: min(340px, 82%);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .mini-grid span {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }
  .mini-grid .on {
    position: absolute;
    top: 8px;
    left: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--online);
    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.35);
  }

  /* Swipe visual */
  .swipe-card {
    position: relative;
    width: min(280px, 74%);
    aspect-ratio: 3 / 4.2;
    border-radius: 20px;
    overflow: hidden;
    transform: rotate(-3deg);
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.8);
  }
  .sc-grain {
    position: absolute;
    inset: 0;
    opacity: 0.1;
    mix-blend-mode: overlay;
    background-image:
      radial-gradient(rgba(255, 255, 255, 0.6) 1px, transparent 1px),
      radial-gradient(rgba(0, 0, 0, 0.6) 1px, transparent 1px);
    background-size: 3px 3px, 3px 3px;
    background-position: 0 0, 1.5px 1.5px;
  }
  .sc-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(0, 0, 0, 0.72));
  }
  .sc-meta {
    position: absolute;
    left: 16px;
    bottom: 16px;
    color: #fff;
  }
  .sc-meta b {
    font-family: var(--font-display);
    font-size: 21px;
    display: block;
  }
  .sc-meta small {
    color: rgba(255, 255, 255, 0.78);
    font-size: 12px;
  }
  .swipe-actions {
    display: flex;
    gap: 18px;
    margin-top: 20px;
  }
  .sa {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 18px;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .sa.pass {
    color: var(--text-2);
  }
  .sa.like {
    color: var(--danger);
    border-color: rgba(255, 77, 94, 0.4);
  }

  /* Links visual */
  .link-pair {
    display: flex;
    align-items: center;
    gap: 0;
  }
  .lp-card {
    width: 132px;
    aspect-ratio: 3 / 4;
    border-radius: 16px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }
  .lp-edge {
    width: 62px;
    height: 2px;
    background: var(--gold);
    position: relative;
    flex-shrink: 0;
  }
  .lp-edge span {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #1a1400;
    background: var(--gold);
    padding: 4px 8px;
    border-radius: 100px;
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .prow {
      grid-template-columns: 1fr;
      gap: 26px;
    }
    .prow .pvis,
    .prow:nth-child(even) .pvis {
      order: 0;
    }
    .ptext p {
      max-width: none;
    }
  }
</style>
