---
const faqs = [
  {
    q: 'Is Pynapli for singles or couples?',
    a: 'Both. Pynapli is for open-minded adults — singles, couples, and partnered people. You choose whether to connect solo, together, or socially.',
  },
  {
    q: 'Do couples share one account?',
    a: 'Never. Every person has their own autonomous account, chats, media, and controls. Linking a partner adds a visible, honest connection — it never merges you into one profile.',
  },
  {
    q: 'Is Pynapli discreet and private?',
    a: 'Yes. A discreet app icon, private albums only you control, approximate-only location, and block and hide tools keep you in charge of what’s seen and who can reach you.',
  },
  {
    q: 'How is this different from other dating apps?',
    a: 'Two proven ways to meet in one app — a live grid for right now, and swipe for intent — plus something no couple-account app offers: every adult keeps their own voice.',
  },
  {
    q: 'Is it free?',
    a: 'Core features — discovery, the essentials of messaging, and safety controls — are free. Some advanced features are optional paid extras. Safety is never paywalled.',
  },
  {
    q: 'Do I have to be 18?',
    a: 'Yes. Pynapli is strictly for adults 18 and over, with verification and active moderation.',
  },
  {
    q: 'When does Pynapli launch?',
    a: 'Soon. Join the waitlist and we’ll let you know the moment it’s live in your city.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="faq" id="faq">
  <div class="container">
    <header class="lead reveal">
      <p class="eyebrow">Questions</p>
      <h2>Good to <em>know.</em></h2>
    </header>
    <div class="faq-list">
      {
        faqs.map((f) => (
          <details class="faq-item reveal">
            <summary>
              <span>{f.q}</span>
              <span class="chev" aria-hidden="true" />
            </summary>
            <div class="ans">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</section>

<style>
  .faq {
    padding: clamp(56px, 8vw, 112px) 0;
    position: relative;
    z-index: 2;
  }
  .faq .container {
    max-width: 820px;
  }
  .lead {
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .lead h2 {
    font-size: clamp(1.9rem, 4vw, 3rem);
    margin-top: 12px;
  }
  .lead em {
    font-style: italic;
    color: var(--gold);
  }
  .faq-item {
    border-top: 1px solid var(--border-soft);
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--border-soft);
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 4px;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    font-weight: 600;
    color: var(--text);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .chev {
    position: relative;
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }
  .chev::before,
  .chev::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 13px;
    height: 2px;
    background: var(--gold);
    border-radius: 2px;
    transform: translate(-50%, -50%);
    transition: transform 0.25s ease;
  }
  .chev::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .faq-item[open] .chev::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  .ans {
    padding: 0 4px 24px;
  }
  .ans p {
    color: var(--text-2);
    line-height: 1.65;
    max-width: 66ch;
  }
</style>
