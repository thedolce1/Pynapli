---
const steps = [
  { n: '1', t: 'Make it yours', d: 'Create your own account — 18+, verified, and fully autonomous. No shared logins, ever.' },
  { n: '2', t: 'Tune discovery', d: 'Dial in grid, swipe, and filters that gatekeep before anyone appears. See only who fits.' },
  { n: '3', t: 'Solo or linked', d: 'Go it alone, or link a partner as a visible connection — never a merged identity.' },
  { n: '4', t: 'On your terms', d: 'Message, match, or plan a night out. Connect solo, together, or socially — your call.' },
];
---

<section class="how2">
  <div class="container">
    <header class="lead reveal">
      <p class="eyebrow">Getting started</p>
      <h2>Your account. <em>Your rules.</em></h2>
    </header>
    <div class="steps">
      {
        steps.map((s) => (
          <div class="step reveal">
            <span class="sn">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .how2 {
    padding: clamp(56px, 8vw, 108px) 0;
    background: var(--surface);
    border-top: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
    position: relative;
    z-index: 2;
  }
  .lead {
    margin-bottom: clamp(36px, 5vw, 64px);
  }
  .lead h2 {
    font-size: clamp(1.9rem, 4vw, 3rem);
    margin-top: 14px;
  }
  .lead em {
    font-style: italic;
    color: var(--gold);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(20px, 2.5vw, 34px);
  }
  .step {
    padding-top: 22px;
    border-top: 2px solid var(--border);
  }
  .sn {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    font-weight: 500;
    color: var(--gold);
    line-height: 1;
  }
  .step h3 {
    font-size: 1.15rem;
    margin: 14px 0 8px;
  }
  .step p {
    color: var(--text-2);
    font-size: 14.5px;
    line-height: 1.55;
  }
  @media (max-width: 820px) {
    .steps {
      grid-template-columns: 1fr 1fr;
      gap: 26px;
    }
  }
  @media (max-width: 480px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
