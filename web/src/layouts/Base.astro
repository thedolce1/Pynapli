---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/manrope';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Pynapli — Grid for now. Swipe for intent. Links for trust.',
  description = 'A location-based social lifestyle app for open-minded adults — singles, couples, and partnered people. Connect solo, together, or socially.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0B0E" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="robots" content="index,follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://pynapli.com" />
    <meta property="og:image" content="/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
    <script>
      // The only JS on the page: reveal-on-scroll (degrades gracefully).
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15 },
        );
        for (const el of els) io.observe(el);
      } else {
        for (const el of els) el.classList.add('in');
      }
    </script>
  </body>
</html>
