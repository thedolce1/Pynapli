---
// Standalone SEO page for the signature differentiator (PSYNC_SPEC): targets
// long-tail searches like "app for couples to swipe together" while every claim
// stays spec-accurate — together-match needs both partners' likes AND the other
// person's consent; nobody is ever added to a chat automatically.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Psync from '../components/Psync.astro';
import Footer from '../components/Footer.astro';
import { APP_SIGNUP_URL } from '../lib/appLinks';

const faqs = [
  {
    q: 'Do my partner and I share an account?',
    a: 'Never. Psync only exists because you don’t — you each keep your own profile, chats, media, and controls. Linking adds a visible, honest connection; it never merges you into one profile.',
  },
  {
    q: 'Can my partner see who I swipe on?',
    a: 'Your swipes stay private while you play. What you share is the outcome: a together-match appears for both of you when everyone’s interested.',
  },
  {
    q: 'What happens after a together-match?',
    a: 'It shows up in Activity for both of you. Nobody is added to a conversation automatically — chats start only with consent, like everywhere else on Pynapli.',
  },
  {
    q: 'What if only one of us likes someone?',
    a: 'Then it’s simply not a together-match. If that person is open to it, it can still count as a regular solo match for the partner who liked them — honestly, separately.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Psync — swipe together with your partner, on your own accounts | Pynapli"
  description="Psync deals you and your linked partner the same swipe deck on your own phones. Private swipes, and a together-match only when you both like someone and they're interested too. Only on Pynapli. 18+."
>
  <Header />
  <main>
    <Psync showMoreLink={false} />

    <section class="steps">
      <div class="container">
        <header class="lead reveal">
          <p class="eyebrow">How a Psync session works</p>
          <h2>Three steps. <em>Three yeses.</em></h2>
        </header>
        <ol class="stepgrid reveal">
          <li>
            <span class="num">01</span>
            <h3>Link your partner</h3>
            <p>
              A visible, honest connection between two autonomous accounts. You each keep your own
              profile, chats, and controls — linking never merges you.
            </p>
          </li>
          <li>
            <span class="num">02</span>
            <h3>Start a session</h3>
            <p>
              Psync deals you both the same deck, on your own phones. Same people, same order — two
              screens.
            </p>
          </li>
          <li>
            <span class="num">03</span>
            <h3>Swipe in private</h3>
            <p>
              Nobody sees your swipes mid-session. A together-match appears only when you both like
              someone <strong>and</strong> they’re interested too — and even then, chats start only
              with consent.
            </p>
          </li>
        </ol>
      </div>
    </section>

    <section class="pfaq">
      <div class="container">
        <header class="lead reveal">
          <p class="eyebrow">Psync questions</p>
          <h2>Asked, <em>answered.</em></h2>
        </header>
        <div class="qa reveal">
          {
            faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="container reveal">
        <h2>Bring your person.</h2>
        <p>Free to join · runs in your browser · your account is always your own.</p>
        <div class="row">
          <a class="btn btn-gold" href={APP_SIGNUP_URL}>Create your account</a>
          <a class="btn btn-ghost" href="/">Explore Pynapli</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Base>

<style>
  .lead .eyebrow {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .lead h2 {
    font-size: clamp(1.9rem, 4vw, 3rem);
    margin-top: 12px;
  }
  .lead em {
    font-style: italic;
    color: var(--gold);
  }

  .steps {
    padding: clamp(56px, 8vw, 110px) 0;
    border-top: 1px solid var(--border-soft);
  }
  .stepgrid {
    list-style: none;
    padding: 0;
    margin: clamp(28px, 4vw, 52px) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(18px, 3vw, 36px);
  }
  .stepgrid li {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 26px 24px;
  }
  .num {
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--gold);
    letter-spacing: 0.08em;
  }
  .stepgrid h3 {
    margin-top: 12px;
    font-size: 19px;
  }
  .stepgrid p {
    margin-top: 10px;
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.6;
  }
  .stepgrid strong {
    color: var(--text);
  }

  .pfaq {
    padding: clamp(56px, 8vw, 110px) 0;
    border-top: 1px solid var(--border-soft);
  }
  .qa {
    margin-top: clamp(24px, 3vw, 40px);
    max-width: 760px;
  }
  .qa details {
    border-bottom: 1px solid var(--border-soft);
    padding: 18px 0;
  }
  .qa summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 17px;
    list-style: none;
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa summary::after {
    content: '+';
    float: right;
    color: var(--text-3);
  }
  .qa details[open] summary::after {
    content: '–';
  }
  .qa p {
    margin-top: 12px;
    color: var(--text-2);
    line-height: 1.65;
    max-width: 64ch;
  }

  .cta-band {
    padding: clamp(64px, 9vw, 120px) 0;
    border-top: 1px solid var(--border-soft);
    text-align: center;
  }
  .cta-band h2 {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
  }
  .cta-band p {
    margin-top: 14px;
    color: var(--text-2);
  }
  .cta-band .row {
    margin-top: 28px;
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 820px) {
    .stepgrid {
      grid-template-columns: 1fr;
    }
  }
</style>
