---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Not found · Pynapli">
  <Header />
  <main class="nf">
    <div class="container">
      <p class="code">404</p>
      <h1>This page wandered off.</h1>
      <p class="sub">The link you followed doesn’t exist (or isn’t live yet).</p>
      <a class="btn btn-gold" href="/">Back to pynapli.com</a>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .nf {
    min-height: 62vh;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 80px 0;
    position: relative;
    z-index: 2;
  }
  .code {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 12vw, 7rem);
    color: var(--gold);
    line-height: 1;
  }
  h1 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin: 8px 0 14px;
  }
  .sub {
    color: var(--text-2);
    margin-bottom: 30px;
  }
</style>
