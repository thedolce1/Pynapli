PYNAPLI_ENV=local
PYNAPLI_SERVER_PORT=8080
PYNAPLI_DATABASE_URL=jdbc:postgresql://localhost:5432/pynapli_dev
PYNAPLI_DATABASE_USER=pynapli
PYNAPLI_DATABASE_PASSWORD=pynapli_dev_password
PYNAPLI_REDIS_URL=redis://localhost:6379
PYNAPLI_MEDIA_STORAGE_PROVIDER=local
PYNAPLI_MEDIA_STORAGE_BUCKET=pynapli-local-media
PYNAPLI_MEDIA_UPLOAD_BASE_URL=http://10.0.2.2:8080
PYNAPLI_MEDIA_LOCAL_UPLOAD_DIR=.pynapli-local-media
PYNAPLI_MEDIA_DEV_AUTO_APPROVE_UPLOADS=true
PYNAPLI_NOTIFICATION_DISPATCH_ENABLED=true
PYNAPLI_NOTIFICATION_DISPATCH_INTERVAL_MS=5000
PYNAPLI_NOTIFICATION_DISPATCH_BATCH_SIZE=50
PYNAPLI_NOTIFICATION_MAX_ATTEMPTS=5
PYNAPLI_NOTIFICATION_PUSH_PROVIDER=local
# Set provider to firebase only when server service-account credentials are available.
# PYNAPLI_FIREBASE_SERVICE_ACCOUNT_PATH=C:\secure\pynapli-firebase-service-account.json
# PYNAPLI_FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Google Play subscription verification stays off in local dev. Enable only with
# a Play Developer API service account that has access to the Pynapli app.
PYNAPLI_PLAY_STORE_PACKAGE_NAME=com.pynapli.app
PYNAPLI_PLAY_STORE_VERIFICATION_ENABLED=false
# PYNAPLI_PLAY_STORE_SERVICE_ACCOUNT_PATH=C:\secure\pynapli-play-service-account.json
# PYNAPLI_PLAY_STORE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# PYNAPLI_PLAY_STORE_DEVELOPER_API_BASE_URL=https://androidpublisher.googleapis.com
# Set only for local/admin tooling. Do not commit real tokens.
# PYNAPLI_ADMIN_API_TOKEN=replace-with-strong-random-token
