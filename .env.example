PYNAPLI_ENV=local
PYNAPLI_SERVER_PORT=8080
PYNAPLI_DATABASE_URL=jdbc:postgresql://localhost:5432/pynapli_dev
PYNAPLI_DATABASE_USER=pynapli
PYNAPLI_DATABASE_PASSWORD=pynapli_dev_password
# Cloud Run + Cloud SQL PostgreSQL: keep DATABASE_URL as jdbc:postgresql:///<db-name>, then set
# the Cloud SQL connector instance name. Use Secret Manager for real database credentials.
# PYNAPLI_DATABASE_URL=jdbc:postgresql:///pynapli_staging
# PYNAPLI_DATABASE_CLOUD_SQL_INSTANCE=pynapli-staging:us-central1:pynapli-postgres
# PYNAPLI_DATABASE_CLOUD_SQL_UNIX_SOCKET_PATH=/cloudsql/pynapli-staging:us-central1:pynapli-postgres
# PYNAPLI_DATABASE_CLOUD_SQL_REFRESH_STRATEGY=lazy
PYNAPLI_REDIS_URL=redis://localhost:6379
PYNAPLI_MEDIA_STORAGE_PROVIDER=local
PYNAPLI_MEDIA_STORAGE_BUCKET=pynapli-local-media
PYNAPLI_MEDIA_UPLOAD_BASE_URL=http://10.0.2.2:8080
PYNAPLI_MEDIA_LOCAL_UPLOAD_DIR=.pynapli-local-media
PYNAPLI_MEDIA_DEV_AUTO_APPROVE_UPLOADS=true
# Production media: set provider to gcs to issue GCS V4 signed upload URLs.
# Signing reuses the Firebase service account unless a dedicated media SA is provided.
# PYNAPLI_MEDIA_STORAGE_PROVIDER=gcs
# PYNAPLI_MEDIA_STORAGE_BUCKET=pynapli-prod-media
# PYNAPLI_MEDIA_GCS_SIGNING_REGION=auto
# PYNAPLI_MEDIA_GCS_SIGNING_SA_PATH=C:\secure\pynapli-media-signer.json
# PYNAPLI_MEDIA_GCS_SIGNING_SA_JSON={"type":"service_account",...}
# Media cleanup worker: purges abandoned/rejected/soft-deleted asset rows on an interval.
# Defaults: enabled in local; 1h interval (min 60s). Storage objects are expired by GCS lifecycle rules.
# PYNAPLI_MEDIA_CLEANUP_ENABLED=true
# PYNAPLI_MEDIA_CLEANUP_INTERVAL_MS=3600000
# Account data-export worker: builds a JSON archive of the user's own data and serves a download URL.
# Defaults: enabled in local; 60s interval (min 10s); archives under .pynapli-account-exports.
# PYNAPLI_ACCOUNT_DATA_EXPORT_ENABLED=true
# PYNAPLI_ACCOUNT_DATA_EXPORT_INTERVAL_MS=60000
# PYNAPLI_ACCOUNT_DATA_EXPORT_DIR=.pynapli-account-exports
# With PYNAPLI_MEDIA_STORAGE_PROVIDER=gcs, archives go to GCS (default: the media bucket) under
# account-exports/; add a bucket lifecycle rule deleting that prefix after 7 days.
# PYNAPLI_ACCOUNT_DATA_EXPORT_BUCKET=
PYNAPLI_NOTIFICATION_DISPATCH_ENABLED=true
PYNAPLI_NOTIFICATION_DISPATCH_INTERVAL_MS=5000
PYNAPLI_NOTIFICATION_DISPATCH_BATCH_SIZE=50
PYNAPLI_NOTIFICATION_MAX_ATTEMPTS=5
PYNAPLI_NOTIFICATION_PUSH_PROVIDER=local
# Set provider to firebase to send real FCM pushes. Credentials resolve in this order:
#   1. PYNAPLI_FIREBASE_SERVICE_ACCOUNT_JSON / _PATH (explicit service-account key), else
#   2. Application Default Credentials (keyless) — `gcloud auth application-default login`
#      locally, or the attached service account on Cloud Run. No JSON key file required.
# With ADC, set the project id so FCM routes reliably:
# PYNAPLI_FIREBASE_PROJECT_ID=pynapli
# PYNAPLI_FIREBASE_SERVICE_ACCOUNT_PATH=C:\secure\pynapli-firebase-service-account.json
# PYNAPLI_FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# App Check boundary stays off locally. In production, turn it on only AFTER the Android App Check
# client ships (otherwise app traffic is blocked). With the project number set, tokens are verified
# cryptographically; without it, enforcement only requires a non-blank X-Firebase-AppCheck header.
# PYNAPLI_APP_CHECK_ENFORCED=true
# PYNAPLI_APP_CHECK_PROJECT_NUMBER=209241465883
# Google Play subscription verification stays off in local dev. Enable only with
# a Play Developer API service account that has access to the Pynapli app.
PYNAPLI_PLAY_STORE_PACKAGE_NAME=com.pynapli.app
PYNAPLI_PLAY_STORE_VERIFICATION_ENABLED=false
# PYNAPLI_PLAY_STORE_SERVICE_ACCOUNT_PATH=C:\secure\pynapli-play-service-account.json
# PYNAPLI_PLAY_STORE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# PYNAPLI_PLAY_STORE_DEVELOPER_API_BASE_URL=https://androidpublisher.googleapis.com
PYNAPLI_PLAY_STORE_SUBSCRIPTION_SYNC_ENABLED=false
PYNAPLI_PLAY_STORE_SUBSCRIPTION_SYNC_INTERVAL_MS=300000
PYNAPLI_PLAY_STORE_SUBSCRIPTION_SYNC_BATCH_SIZE=100
PYNAPLI_PLAY_STORE_SUBSCRIPTION_SYNC_STALE_AFTER_HOURS=6
PYNAPLI_PLAY_STORE_SUBSCRIPTION_SYNC_RENEWAL_LOOKAHEAD_HOURS=24
PYNAPLI_PLAY_STORE_RTDN_ENABLED=false
# Use a long random token for local/API Gateway routing, or configure Pub/Sub
# authenticated push with OIDC audience and service account email.
# PYNAPLI_PLAY_STORE_RTDN_WEBHOOK_TOKEN=replace-with-strong-random-token
# PYNAPLI_PLAY_STORE_RTDN_OIDC_AUDIENCE=https://api.pynapli.com/v1/webhooks/play-store/rtdn
# PYNAPLI_PLAY_STORE_RTDN_OIDC_SERVICE_ACCOUNT_EMAIL=pubsub-push@pynapli-prod.iam.gserviceaccount.com
# Set only for local/admin tooling. Do not commit real tokens.
# PYNAPLI_ADMIN_API_TOKEN=replace-with-strong-random-token
# Optional two-tier admin role map ("id:role,id:role"; roles: operator | senior). When unset, role
# enforcement is off and every admin is treated as senior. When set, unmapped actors default to
# operator and sensitive actions (PII reveals, entitlement changes, appeal decisions, media removal)
# require the senior role.
# PYNAPLI_ADMIN_ROLES=alice:senior,bob:operator
# Optional step-up MFA for sensitive admin actions. When enforced, those endpoints require a valid
# TOTP code (RFC 6238) in the X-Admin-MFA header, verified against each admin's base32 secret. Off by
# default. Secrets format: "id:base32secret,id:base32secret".
# PYNAPLI_ADMIN_MFA_ENFORCED=false
# PYNAPLI_ADMIN_MFA_SECRETS=alice:GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ
# Production-like environments must set unique, strong runtime signing secrets. Store these in
# Secret Manager on Cloud Run; never reuse the local defaults.
# PYNAPLI_DISCOVERY_CURSOR_SECRET=replace-with-strong-random-secret
# PYNAPLI_ACTIVITY_CURSOR_SECRET=replace-with-another-strong-random-secret
# PYNAPLI_SWIPE_DECK_TOKEN_SECRET=replace-with-a-third-strong-random-secret
# K3: keys the "Met in person" voucher/pair tokens so a database leak alone doesn't show who met whom.
# Required (strong, distinct) in staging/production. Never rotate or lose it once confirmations exist.
# PYNAPLI_MET_IN_PERSON_TOKEN_SECRET=replace-with-a-fourth-strong-random-secret
PYNAPLI_SUPPORT_EMAIL=support@pynapli.com
# Forgot-password code delivery: "log" (PYNAPLI_ENV=local only; codes go to .pynapli-local-mail/reset-codes.txt)
# or "none" (reset is unavailable and the app points people to support). Needs an email provider for production.
# PYNAPLI_PASSWORD_RESET_MAILER=none

# ---------------------------------------------------------------------------
# Added 2026-07-27: these are read by ServerConfig but were previously in no
# document, so a deploy could fail startup on a variable nobody had written down.
# ---------------------------------------------------------------------------

# Media delivery + moderation. Delivery must be signed_gcs or cdn; moderation manual or cloud_vision.
# NOTE the moderation default: "manual" means NO automated image scanning. For a public launch this
# is a deliberate trust decision, not something to leave at the default by accident.
# PYNAPLI_MEDIA_DELIVERY_PROVIDER=signed_gcs
# PYNAPLI_MEDIA_MODERATION_PROVIDER=manual
# PYNAPLI_MEDIA_MODERATION_VISION_ENDPOINT=https://vision.googleapis.com/v1/images:annotate
# Required ONLY when PYNAPLI_MEDIA_DELIVERY_PROVIDER=cdn — startup fails without all three.
# PYNAPLI_MEDIA_CDN_BASE_URL=
# PYNAPLI_MEDIA_CDN_SIGNING_KEY_NAME=
# PYNAPLI_MEDIA_CDN_SIGNING_KEY_BASE64URL=

# Log format: json on deployed environments (one Cloud Logging entry per line with severity and
# requestId); unset or anything else keeps readable text.
# PYNAPLI_LOG_FORMAT=json

# Bearer token for the Prometheus scrape endpoint GET /metrics (16+ chars). Unset = no endpoint.
# PYNAPLI_METRICS_TOKEN=

# Proxies in front of the API that append to X-Forwarded-For; the client IP used for per-IP
# sign-in limits is that many entries from the end (Cloud Run: 1). Range 0-5.
# PYNAPLI_TRUSTED_PROXY_HOPS=1

# Activity retention worker. Default is ON for local and OFF everywhere else, so on staging/prod the
# activity table grows without bound until this is set explicitly. Interval floor is 60000 ms.
# PYNAPLI_ACTIVITY_RETENTION_ENABLED=true
# PYNAPLI_ACTIVITY_RETENTION_INTERVAL_MS=3600000

# Data retention worker (ON by default everywhere): deletes expired disappearing messages after a
# moderation grace, dead sessions, old password-reset codes and old Play notification payloads.
# Runs on one replica at a time. Grace is 0-365 days; interval floor is 60000 ms.
# PYNAPLI_DATA_RETENTION_ENABLED=true
# PYNAPLI_DATA_RETENTION_INTERVAL_MS=3600000
# PYNAPLI_EXPIRED_MESSAGE_GRACE_DAYS=30

# Cloud SQL pool tuning — worth setting on Cloud Run, where instance count multiplies connections
# against the Cloud SQL limit. Accepted ranges: pool 1-100, min idle 0-100, timeout 1000-60000 ms.
# PYNAPLI_DATABASE_MAX_POOL_SIZE=
# PYNAPLI_DATABASE_MIN_IDLE=
# PYNAPLI_DATABASE_CONNECTION_TIMEOUT_MS=5000

# Request profiling. Off by default; when enabled it MUST stay header-gated in production-like
# environments (validation code API_PROFILING_HEADER_REQUIRED) so it cannot be turned on for
# everyone. Send X-Pynapli-Profile to opt a request in.
# PYNAPLI_API_PROFILING_ENABLED=false
# PYNAPLI_API_PROFILING_HEADER_REQUIRED=true
# PYNAPLI_API_PROFILING_SLOW_SPAN_MS=250

# Third-party age verification. Both the provider and the redirect base URL must be set for the real
# provider flow to activate; otherwise age verification stays in its built-in mode.
# PYNAPLI_AGE_VERIFICATION_PROVIDER=
# PYNAPLI_AGE_VERIFICATION_PROVIDER_LABEL=
# PYNAPLI_AGE_VERIFICATION_PROVIDER_REDIRECT_BASE_URL=
# Secret the provider signs POST /v1/verification/callback with (HMAC-SHA256 over
# "<X-Pynapli-Timestamp>.<raw body>", sent as X-Pynapli-Signature: v1=<hex>; 5-minute window).
# Unset: the callback route is not served. Required (32+ chars, not the admin token) in staging and
# production whenever PYNAPLI_AGE_VERIFICATION_PROVIDER is set. Keep it in Secret Manager.
# PYNAPLI_AGE_VERIFICATION_CALLBACK_SECRET=

# Travel mode destination rules by ISO country code, comma-separated: CC=blocked (refused and hidden
# from destination search) or CC=age_verified (needs age verification first). The country is
# resolved from the destination's coordinates, not the client's label. Empty: no rules. A malformed
# value fails startup. Example: AE=blocked,QA=age_verified
# PYNAPLI_TRAVEL_REGION_POLICY=

# Store test modes. Both default false outside local and BOTH are rejected by startup validation in
# production (DEV_STORE_PURCHASES_FORBIDDEN / PLAY_STORE_SANDBOX_FORBIDDEN). Listed so their
# existence is discoverable rather than a surprise in an error message.
# PYNAPLI_DEV_STORE_PURCHASES_ENABLED=false
# PYNAPLI_PLAY_STORE_SANDBOX_ENABLED=false
